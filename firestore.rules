rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Função auxiliar para verificar permissão de administrador
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in ['djkleber@gmail.com']
      );
    }

    match /users/{userId} {
      // Leitura de um usuário: o próprio usuário ou o administrador
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Listagem geral de usuários: exclusivamente para o administrador
      allow list: if isAdmin();
      
      // Gravação: administrador pode alterar tudo (incluindo status); 
      // Usuário pode gravar se for o dono da conta e não estiver com acesso bloqueado.
      // Usamos checagem defensiva de existência (!('status' in resource.data)) para evitar erros caso o campo ainda não exista.
      allow write: if request.auth != null && (
        isAdmin() || 
        (
          request.auth.uid == userId && 
          (resource == null || !('status' in resource.data) || resource.data.status != 'blocked')
        )
      );
    }
  }
}
