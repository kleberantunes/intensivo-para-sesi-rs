rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('email', '') == 'djkleber@gmail.com'
        && request.auth.token.get('email_verified', false) == true;
    }
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validScore() {
      return request.resource.data.answered is int && request.resource.data.answered >= 0
        && request.resource.data.correct is int && request.resource.data.correct >= 0
        && request.resource.data.correct <= request.resource.data.answered;
    }
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() || (isOwner(uid) && validScore()
        && request.resource.data.get('status', 'active') == 'active');
      allow update: if isAdmin() || (isOwner(uid) && validScore()
        && resource.data.get('status', 'active') != 'blocked'
        && request.resource.data.get('status', 'active') == resource.data.get('status', 'active')
        && request.resource.data.answered >= resource.data.get('answered', 0)
        && request.resource.data.correct >= resource.data.get('correct', 0));
      allow delete: if isAdmin();
    }
  }
}
